{
  "routes": [
    {
      "src": "^/c/([^/]+)$",
      "dest": "/api/channel-page?username=$1"
    },
    {
      "src": "^/p/([^/]+)$",
      "dest": "/api/channel-page?id=$1"
    },
    {
      "src": "^/sitemap\\.xml$",
      "dest": "/api/sitemap"
    }
  ],
  "crons": [
    {
      "path": "/api/cron-refresh-meta",
      "schedule": "0 2 * * *"
    }
  ]
}
