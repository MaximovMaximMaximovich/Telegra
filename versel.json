{
  "rewrites": [
    {
      "source": "/c/:username",
      "destination": "/api/channel-page?username=:username"
    },
    {
      "source": "/p/:id",
      "destination": "/api/channel-page?id=:id"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    }
  ],
  "crons": [
    {
      "path": "/api/cron-refresh-meta",
      "schedule": "0 2 * * *"
    }
  ]
}
